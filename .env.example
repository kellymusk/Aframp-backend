DATABASE_URL=postgres://postgres:postgres@localhost/aframp
# Use 0.0.0.0:3000 in a container deployment.
APP_BIND_ADDR=127.0.0.1:3000
JWT_SECRET=replace-in-production
WEBHOOK_SECRET=replace-in-production
# openssl rand -hex 32 — used to AES-256-GCM encrypt per-wallet Stellar secret seeds at rest
WALLET_ENCRYPTION_KEY=replace-in-production
STELLAR_SYSTEM_WALLET_ADDRESS=G...YOUR_STELLAR_SYSTEM_WALLET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_POLL_INTERVAL_SECS=60
# Paystack Dashboard > Settings > API Keys & Webhooks. sk_test_... for dev, sk_live_... only once
# the business is verified/activated for Transfers (see PRD §9.1).
PAYSTACK_SECRET_KEY=sk_test_replace-in-production
# openssl rand -hex 32 — keys the HMAC that OTP codes are stored under. Never reused elsewhere;
# a bare hash of a 6-digit code is trivially reversible without a secret like this.
OTP_HMAC_SECRET=replace-in-production
# `mock` logs the OTP instead of sending it (see src/otp/mock.rs) — use it for local dev so you
# never need live Termii credentials. `termii` is the default; set explicitly for prod.
OTP_PROVIDER=mock
# Termii Dashboard > API Keys. Required only when OTP_PROVIDER=termii.
TERMII_API_KEY=replace-in-production
# Must be a sender ID already registered/approved in the Termii dashboard.
TERMII_SENDER_ID=Aframp
# Comma-separated browser origins allowed to call the API. Unlisted origins fail preflight.
CORS_ALLOWED_ORIGINS=http://localhost:3001
# Session cookie. Leave these alone unless the frontend is on a different origin than the API:
# browsers treat localhost as a secure context, so Secure works in dev too. SameSite=none lets
# the session ride cross-site requests (and forces Secure) — prefer serving the frontend
# same-origin behind one reverse proxy. See README "Deploying behind TLS".
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
