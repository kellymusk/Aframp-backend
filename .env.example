# Aframp backend environment configuration
# Copy this file to `.env` and fill in real values for your environment:
#   cp .env.example .env
#
# Variables marked [REQUIRED] must be set or the server refuses to start.
# Variables marked [OPTIONAL] fall back to the defaults shown below.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# [REQUIRED] PostgreSQL connection string used by the app and migrations.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aframp

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
# [OPTIONAL] Address the API binds to. Default: 127.0.0.1:3000
APP_BIND_ADDR=127.0.0.1:3000

# [OPTIONAL] Comma-separated list of browser origins allowed to call the API.
# The merchant frontend runs on a separate origin. Default: http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# [REQUIRED] Secret used to sign JWTs. Generate with:
#   openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32

# [REQUIRED] Secret used to verify inbound webhook signatures.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=replace-with-openssl-rand-hex-32

# [REQUIRED] Key used to encrypt stored wallet secrets at rest.
# Generate with: openssl rand -hex 32
WALLET_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# [REQUIRED] HMAC key that OTP codes are hashed under before storage.
# Generate with: openssl rand -hex 32
OTP_HMAC_SECRET=replace-with-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# Stellar
# ---------------------------------------------------------------------------
# [REQUIRED] Stellar account address that receives system payments.
# Use a testnet account for local development.
STELLAR_SYSTEM_WALLET_ADDRESS=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# [OPTIONAL] Horizon endpoint. Defaults to testnet:
#   testnet: https://horizon-testnet.stellar.org
#   mainnet: https://horizon.stellar.org
DATABASE_URL=postgres://postgres:postgres@localhost/aframp
# Connection pool sizing. DB_MAX_CONNECTIONS should be lowered for constrained managed Postgres
# tiers (e.g. Supabase free tier's 15-connection limit, shared across all apps) and raised for
# production load. DB_MIN_CONNECTIONS keeps idle connections warm; DB_ACQUIRE_TIMEOUT_SECS is how
# long a request waits for a free connection before failing.
DB_MAX_CONNECTIONS=5
DB_MIN_CONNECTIONS=0
DB_ACQUIRE_TIMEOUT_SECS=30
# Use 0.0.0.0:3000 in a container deployment.
APP_BIND_ADDR=127.0.0.1:3000
# Must be at least 32 bytes (e.g. `openssl rand -hex 32`); startup fails with a descriptive
# error otherwise.
JWT_SECRET=replace-in-production
# Must be at least 32 bytes (e.g. `openssl rand -hex 32`); startup fails with a descriptive
# error otherwise.
WEBHOOK_SECRET=replace-in-production
# openssl rand -hex 32 — used to AES-256-GCM encrypt per-wallet Stellar secret seeds at rest.
# Must be at least 32 bytes; startup fails with a descriptive error otherwise.
WALLET_ENCRYPTION_KEY=replace-in-production
# RESERVED_FOR_FUTURE_USE — sweep/settlement wallet.
# This is the platform's own Stellar address that will eventually receive funds
# swept from individual merchant wallets before fiat conversion (see README §Settlement/sweep wallet).
# It is validated at startup to catch misconfigured keys early, but no code paths
# use it yet. Do not implement anything against this variable until the sweep
# architecture is finalized. See docs/proposals/ for the planned flow.
STELLAR_SYSTEM_WALLET_ADDRESS=G...YOUR_STELLAR_SYSTEM_WALLET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# [OPTIONAL] Seconds between Horizon polling passes. Default: 60
STELLAR_POLL_INTERVAL_SECS=60

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# [REQUIRED] Paystack secret key. Use a test key (sk_test_...) for local dev.
PAYSTACK_SECRET_KEY=sk_test_replace-with-paystack-test-key

# ---------------------------------------------------------------------------
# OTP delivery
# ---------------------------------------------------------------------------
# [OPTIONAL] SMS backend for OTP codes. Valid values: `mock` | `termii`.
# `mock` logs the code instead of sending it — use it for local development.
# Default: termii
OTP_PROVIDER=mock

# [REQUIRED when OTP_PROVIDER=termii] Termii API key.
TERMII_API_KEY=replace-with-termii-api-key

# [REQUIRED when OTP_PROVIDER=termii] Termii sender ID shown to recipients.
# Number of Stellar ledger closes that must pass after a deposit is detected before its
# pending balance is promoted to available. Stellar finality is ~5s; raise this for extra
# safety on high-value deposits. Defaults to 1.
STELLAR_MIN_CONFIRMATIONS=1
# Paystack Dashboard > Settings > API Keys & Webhooks. sk_test_... for dev, sk_live_... only once
# the business is verified/activated for Transfers (see PRD §9.1).
PAYSTACK_SECRET_KEY=sk_test_replace-in-production
# openssl rand -hex 32 — keys the HMAC that OTP codes are stored under. Never reused elsewhere;
# a bare hash of a 6-digit code is trivially reversible without a secret like this.
# Must be at least 32 bytes; startup fails with a descriptive error otherwise.
OTP_HMAC_SECRET=replace-in-production
# `mock` logs the OTP instead of sending it (see src/otp/mock.rs) — use it for local dev so you
# never need live Termii credentials. `termii` is the default; set explicitly for prod.
# WARNING (#1241): `mock` writes the full OTP message — including the 6-digit code — to the logs
# in plaintext. NEVER use OTP_PROVIDER=mock with real phone numbers, or in staging/production
# where logs are shipped to an aggregator. Run `scripts/check_otp_provider.sh` before deploying.
OTP_PROVIDER=mock
# Termii Dashboard > API Keys. Required only when OTP_PROVIDER=termii.
TERMII_API_KEY=replace-in-production
# Dedicated secret Termii uses to sign webhook payloads (HMAC-SHA512 of the raw body, sent in
# the signature header). Set this in production so webhook verification doesn't depend on the
# API key. If it's absent, the app falls back to TERMII_API_KEY and logs a startup warning.
TERMII_WEBHOOK_SECRET=replace-in-production
# Must be a sender ID already registered/approved in the Termii dashboard.
TERMII_SENDER_ID=Aframp

# ---------------------------------------------------------------------------
# Session cookies
# ---------------------------------------------------------------------------
# [OPTIONAL] Whether the session cookie is marked Secure. Valid: true | false.
# Default: true (localhost is treated as a secure context, so this works locally).
COOKIE_SECURE=true

# [OPTIONAL] SameSite attribute for the session cookie. Valid: `lax` | `none`.
# `none` requires COOKIE_SECURE=true. Default: lax
COOKIE_SAME_SITE=lax
# Log output format. `text` (default) is human-readable for local dev; `json` emits one
# structured JSON object per line for production log aggregators (Datadog, CloudWatch, etc.).
LOG_FORMAT=text
